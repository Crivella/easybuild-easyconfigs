easyblock = 'ConfigureMake'

name = 'libXt'
version = '1.3.1'

homepage = 'https://gitlab.freedesktop.org/xorg/lib/libxt'
description = """X Toolkit Intrinsics library."""

toolchain = {'name': 'GCCcore', 'version': '12.3.0'}

source_urls = ['https://www.x.org/releases/individual/lib/']
sources = [SOURCE_TAR_GZ]
checksums = ['cf2212189869adb94ffd58c7d9a545a369b83d2274930bfbe148da354030b355']

builddependencies = [
    ('binutils', '2.40'),
    ('Autotools', '20220317'),
    ('xorg-macros', '1.20.0'),
]

sanity_check_paths = {
    'files': ['lib/%(name)s.a', 'lib/%%(name)s.%s' % SHLIB_EXT],
    'dirs': ['lib/pkgconfig'],
}

moduleclass = 'system'
