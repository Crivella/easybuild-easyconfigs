easyblock = 'PythonBundle'

name = 'PyGithub'
version = '2.8.1'

homepage = 'https://github.com/pygithub/pygithub'
description = """PyGitHub is a Python library to access the GitHub REST API.
This library enables you to manage GitHub resources such as repositories, user
profiles, and organizations in your Python applications."""

toolchain = {'name': 'GCCcore', 'version': '12.3.0'}

dependencies = [
    ('Python', '3.11.3'),
    ('Python-bundle-PyPI', '2023.06'),
]

exts_list = [
    ('PyJWT', '2.8.0', {
        'modulename': 'jwt',
        'checksums': ['57e28d156e3d5c10088e0c68abb90bfac3df82b40a71bd0daa20c65ccd5c23de'],
    }),
    (name, version, {
        'modulename': 'github',
        'sources': ['%(namelower)s-%(version)s.tar.gz'],
        'checksums': ['341b7c78521cb07324ff670afd1baa2bf5c286f8d9fd302c1798ba594a5400c9'],
    }),
]

moduleclass = 'tools'
