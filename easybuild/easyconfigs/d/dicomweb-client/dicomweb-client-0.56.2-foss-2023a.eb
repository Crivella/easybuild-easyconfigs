easyblock = 'PythonBundle'

name = 'dicomweb-client'
version = '0.56.2'

homepage = 'https://github.com/imagingdatacommons/dicomweb-client'
description = "Python client for DICOMweb services."

toolchain = {'name': 'foss', 'version': '2023a'}

builddependencies = [
    ('binutils', '2.40'),
]
dependencies = [
    ('Python', '3.11.3'),
    ('Python-bundle-PyPI', '2023.06'),
    ('hatchling', '1.18.0'),
    ('SciPy-bundle', '2023.07'),
    ('Pillow', '10.0.0'),
    ('pydicom', '2.4.4'),
]

exts_list = [
    ('retrying', '1.3.4', {
        'checksums': ['345da8c5765bd982b1d1915deb9102fd3d1f7ad16bd84a9700b85f64d24e8f3e'],
    }),
    (name, version, {
        'github_account': 'imagingdatacommons',
        'source_urls': ['https://github.com/%(github_account)s/%(name)s/archive'],
        'checksums': ['8e7782e3958dcb1db8912b5f1d689a4b9cc92e56e0684b98898c7b8c7b47beb1'],
    }),
]

moduleclass = 'vis'
