# Contributors:
# Fenglai Liu (fenglai@accre.vanderbilt.edu) - Vanderbilt University
# Alex Domingo (alex.domingo.toro@vub.be) - Vrije Universiteit Brussel (VUB)
# Denis Kristak (INUITS)
#
easyblock = 'CMakeMake'

name = 'CTK'
version = '2025-09-04'
versionsuffix = '-slicer'

homepage = 'https://itk.org'
description = """Insight Segmentation and Registration Toolkit (ITK) provides
 an extensive suite of software tools for registering and segmenting
 multidimensional imaging data."""

toolchain = {'name': 'foss', 'version': '2023a'}
toolchainopts = {'pic': True, 'cstd': 'c++11'}

# From https://github.com/Slicer/Slicer/blob/v5.8.1/SuperBuild/External_CTK.cmake#L74
_ctk_commit = '833ae56e69d403bd0c83f2c331a32a8fd9c70285'
_pyqt_commit = '37b0d31e5d313f5682f774bd8d5d41f5018a2ce9'
_cmake_builddir = 'build'
sources = [
    {
        'filename': f'CTK-{_ctk_commit[:8]}.tar.xz',
        'git_config': {
            'url': 'https://github.com/commontk',
            'repo_name': '%(name)s',
            'commit': _ctk_commit,
            'recursive': True,
        },
    },
    {
        'filename': f'PythonQt-{_pyqt_commit[:8]}.tar.xz',
        'git_config': {
            'url': 'https://github.com/commontk',
            'repo_name': 'PythonQt',
            'commit': _pyqt_commit,
            'recursive': True,
        },
        'extract_cmd': f'mkdir -p %(builddir)s/{_cmake_builddir}/PythonQt && tar xvf %s --strip-components=1 -C $_',
    },
]
patches = ['CTK-2025-09-04-useEBsources.patch']

builddependencies = [
    ('CMake', '3.26.3'),
    # ('git', '2.41.0', '-nodocs'),  # For now used to pull in PythonQt
]
dependencies = [
    ('Python', '3.11.3'),
    ('ITK', '5.3.0', '-slicer'),
    # ('DCMTK', '3.6.6'),
]

separate_build_dir = _cmake_builddir  # Ensure extracted PythonQt is in the build dir
build_shared_libs = True

# Features
configopts = ' '.join([
    "-DCTK_QT_VERSION:STRING=5",
    "-DQt5_DIR=$EBROOTQT5/lib/cmake/Qt5",

    "-DCTK_BUILD_QTDESIGNER_PLUGINS=ON",

    "-DCTK_USE_GIT_PROTOCOL=OFF",

    # "-DCTK_USE_SYSTEM_DCMTK=ON",
    "-DCTK_USE_SYSTEM_VTK=ON",
    "-DCTK_USE_SYSTEM_ITK=ON",
    # "-DCTK_USE_SYSTEM_PythonQt=ON",  # Needs its own version with the ctkXXX wrappers

    "-DDCMTK_DIR=$EBROOTDCMTK/lib/cmake/dcmtk",
    "-DVTK_DIR=$EBROOTVTK/lib/cmake/vtk-9.3",
    "-DITK_DIR=$EBROOTITK/lib/cmake/ITK-5.3",

    "-DTBB_DIR=$EBROOTTBB/lib/cmake/TBB",

    "-DBUILD_TESTING=OFF",

    "-DCTK_LIB_Widgets=ON",
    "-DCTK_LIB_Visualization/VTK/Widgets=ON",
    "-DCTK_LIB_Visualization/VTK/Widgets_USE_TRANSFER_FUNCTION_CHARTS=ON",
    "-DCTK_LIB_ImageProcessing/ITK/Core=ON",
    "-DCTK_LIB_PluginFramework=OFF",
    "-DCTK_PLUGIN_org.commontk.eventbus=OFF",

    "-DCTK_APP_ctkDICOM=OFF",
    "-DCTK_LIB_DICOM/Core=OFF",
    "-DCTK_LIB_DICOM/Widgets=OFF",
    "-DCTK_USE_QTTESTING=OFF",
    # "-DGIT_EXECUTABLE=$EBROOTGIT/bin/git",

    "-DCTK_LIB_Scripting/Python/Core=ON",
    "-DCTK_LIB_Scripting/Python/Core_PYTHONQT_USE_VTK=ON",
    "-DCTK_LIB_Scripting/Python/Core_PYTHONQT_WRAP_QTCORE=ON",
    "-DCTK_LIB_Scripting/Python/Core_PYTHONQT_WRAP_QTGUI=ON",
    "-DCTK_LIB_Scripting/Python/Core_PYTHONQT_WRAP_QTUITOOLS=ON",
    "-DCTK_LIB_Scripting/Python/Core_PYTHONQT_WRAP_QTNETWORK=ON",
    "-DCTK_LIB_Scripting/Python/Core_PYTHONQT_WRAP_QTMULTIMEDIA=OFF",
    "-DCTK_LIB_Scripting/Python/Core_PYTHONQT_WRAP_QTWEBKIT=OFF",
    "-DCTK_LIB_Scripting/Python/Widgets=ON",
    "-DCTK_ENABLE_Python_Wrapping=ON",

    "-DCTK_INSTALL_BIN_DIR=%(installdir)s/bin",
    "-DCTK_INSTALL_LIB_DIR=%(installdir)s/lib",
    "-DCTK_INSTALL_PLUGIN_DIR=%(installdir)s/lib/plugins",
    "-DCTK_INSTALL_CMAKE_DIR=%(installdir)s/lib/cmake/ctk",
    "-DCTK_INSTALL_INCLUDE_DIR=%(installdir)s/include/ctk",
    "-DCTK_INSTALL_PLUGIN_INCLUDE_DIR=%(installdir)s/include/ctk",
    "-DCTK_INSTALL_QTPLUGIN_DIR=%(installdir)s/lib",
    "-DCTK_INSTALL_DOC_DIR=%(installdir)s/share/doc",
])

preinstallopts = ' && '.join([
    # Also install the PythonQt files
    'cp -r CMakeExternals/Install/* %(installdir)s/',
    # https://github.com/commontk/PythonQt/issues/11
    'cp %(builddir)s/%(name)s/Utilities/CMake/FindPythonQt.cmake %(installdir)s/lib/cmake/ctk/',
    'cp %(builddir)s/%(name)s/Utilities/CMake/FindPythonQtGenerator.cmake %(installdir)s/lib/cmake/ctk/',
    # Running install from the main build dir only install the CMake config files
    'cd CTK-build',
    ''  # Ensure ' && ' at the end
])

_libs = [
    'CTKCore', 'CTKWidgets', 'CTKImageProcessingITKCore', 'CTKScriptingPythonCore', 'CTKScriptingPythonWidgets',
    'PythonQt'
]
_files = [f'lib/lib{lib}.{SHLIB_EXT}' for lib in _libs]
sanity_check_paths = {
    'files': _files,
    'dirs': ['include/ctk', 'include/PythonQt', 'lib/cmake'],
}

# sanity_check_commands = ["python -c 'import itk'"]

moduleclass = 'data'
