easyblock = 'CMakeMake'

name = 'Slicer'
version = '5.8.1'

homepage = 'https://slicer.readthedocs.io/en/latest/index.html'
description = """A software application for visualization and analysis of
medical image computing data sets. All commonly used data sets are supported,
such as images, segmentations, surfaces, annotations, transformations, etc., in
2D, 3D, and 4D. Visualization is available on desktop and in virtual reality.
Analysis includes segmentation, registration, and various quantifications."""

toolchain = {'name': 'foss', 'version': '2023a'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/%(namelower)s/%(namelower)s/archive/refs/tags']
sources = ['v%(version)s.tar.gz']
patches = ['Slicer-5.8.1.patch']
# checksums = ['3c743204df78366ad2eaf236d6631d83f6bc928d1705dd0000b872e53b73dc6a']

builddependencies = [
    ('binutils', '2.40'),
    ('CMake', '3.31.8'),
    # ('Ninja', '1.12.1'),
    ('SWIG', '4.1.1'),
    # ('pkgconf', '2.2.0'),
    ('git', '2.41.0', '-nodocs'),
    ('git-lfs', '3.6.1', '', SYSTEM),
]
dependencies = [
    ('OpenSSL', '3', '', SYSTEM),
    ('zlib', '1.2.13'),
    # ('libXt', '1.3.1'),
    ('cURL', '8.0.1'),
    # ('SQLite', '3.45.3'),

    ('Qt5', '5.15.10'),
    # ('tbb', '2021.13.0'),
    # ('VTK', '9.3.0', '-qtsql'),
    # ('ITK', '5.3.0', '-slicer'),
    # ('SimpleITK', '2.3.1', '-slicer'),

    ('Python', '3.11.3'),
    ('nose3', '1.3.8'),
    ('CouchDB', '1.2'),
    ('GitPython', '3.1.40'),
    ('PyGithub', '2.8.1'),  # github, PyJWT
    ('dicomweb-client', '0.56.2'),
    ('Deprecated', '1.2.14'),  # deprecated, wrapt
    # ('PyQt5', '5.15.10'),

    # ('DCMTK', '3.6.9'),
    ('libarchive', '3.6.2'),
    ('RapidJSON', '1.1.0-20230928'),
    ('JsonCpp', '1.9.5'),
]

# preconfigopts = ' '.join([
#     'export TBB_DIR=${EBROOTTBB} &&',
# ])


# Use the EB version of these dependencies instead of cloning+building them
_system_pkgs = [
    'zlib',
    'OpenSSL',
    'curl',
    'python',
    # 'python-numpy',
    # 'python-scipy',
    # 'DCMTK',
    # 'tbb',  # Not supported
    # 'VTK',
    # 'ITK',
    # 'SimpleITK',
    'LibArchive',
    'RapidJSON',
    'JsonCpp',
]

configopts = ' '.join(f'-DSlicer_USE_SYSTEM_{pkg}=ON' for pkg in _system_pkgs)

configopts += ' ' + ' '.join([
    # The alternative is TBB which is not supported as a system dependency
    '-DSlicer_VTK_SMP_IMPLEMENTATION_TYPE=Sequential',
    '-DSlicer_BUILD_MULTIMEDIA_SUPPORT=OFF'
    '-DSlicer_USE_QtTesting=OFF'
])

sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': [],
}

moduleclass = 'vis'
